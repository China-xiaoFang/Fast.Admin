diff --git a/es/components/form/src/form-label-wrap.mjs b/es/components/form/src/form-label-wrap.mjs
--- a/es/components/form/src/form-label-wrap.mjs
+++ b/es/components/form/src/form-label-wrap.mjs
@@ -21,6 +21,13 @@ var form_label_wrap_default = /* @__PURE__ */ defineComponent({
 		const getLabelWidth = () => {
 			if (el.value?.firstElementChild) {
 				const width = window.getComputedStyle(el.value.firstElementChild).width;
+				/**
+				 * 修复 el-form 使用 label-width="auto" 且组件处于隐藏状态时，
+				 * getComputedStyle() 可能返回 "auto"，导致 parseFloat() 产生 NaN，
+				 * 最终触发 “[ElForm] unexpected width NaN”。
+				 * Issue: https://github.com/element-plus/element-plus/issues/21453
+				 */
+				if (width === "auto") return "auto";
 				return Math.ceil(Number.parseFloat(width));
 			} else return 0;
 		};
